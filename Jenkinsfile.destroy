pipeline {

    agent any

    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        skipDefaultCheckout(true)

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )

        timeout(
            time: 120,
            unit: 'MINUTES'
        )
    }

    // ============================================================
    // PARAMETERS
    // ============================================================

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'qa',
                'stage',
                'prod'
            ],
            description: 'AWS/Kubernetes environment to DESTROY'
        )

        booleanParam(
            name: 'DELETE_TERRAFORM_BACKEND',
            defaultValue: false,
            description: 'Also delete the Terraform S3 state bucket and DynamoDB lock table (DESTRUCTIVE - affects ALL environments)'
        )

        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'Tick to confirm you really want to destroy all resources for the selected environment'
        )
    }

    // ============================================================
    // GLOBAL ENVIRONMENT
    // ============================================================

    environment {

        AWS_REGION = 'us-east-1'
        AWS_DEFAULT_REGION = 'us-east-1'

        APPLICATION_REPO =
            'https://github.com/FAIZANSHEIKH223/application-code.git'

        TERRAFORM_REPO =
            'https://github.com/FAIZANSHEIKH223/terraform-infrastructure-EWS-Cloudwatch.git'

        CICD_REPO =
            'https://github.com/FAIZANSHEIKH223/cicd-jenkins-orchestration-EKS-cloudwatch.git'

        APPLICATION_DIR =
            'application-code'

        TERRAFORM_DIR =
            'terraform-infrastructure-EWS-Cloudwatch'

        CICD_DIR =
            'cicd-jenkins-orchestration-EKS-cloudwatch'

        EKS_PROJECT_NAME =
            'practice1'

        CONTAINER_NAME =
            'practice1'

        CONTAINER_PORT =
            '8501'

        K8S_NAMESPACE =
            'practice1'

        K8S_DEPLOYMENT =
            'practice1-deployment'

        K8S_SERVICE =
            'practice1-service'

        GITHUB_CREDENTIALS_ID =
            'github-creds'

        AWS_CREDENTIALS_ID =
            'aws-creds'

        TERRAFORM_STATE_BUCKET =
            'terraform-state-faizan-001'

        TERRAFORM_LOCK_TABLE =
            'terraform-locks'

        JENKINS_PRINCIPAL_ARN =
            'arn:aws:iam::103282536465:user/terraformlearnt'

        // Report file
        DELETION_REPORT = 'deletion-report.txt'
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // 00. CONFIRMATION GATE + INIT REPORT
        // ========================================================

        stage('00 - Confirm Destruction') {

            steps {

                script {

                    if (!params.CONFIRM_DESTROY) {

                        error(
                            "Destruction not confirmed. " +
                            "Please tick the 'CONFIRM_DESTROY' parameter and re-run."
                        )
                    }

                    echo """
==============================================================
                 DESTROY PIPELINE STARTED
==============================================================

Environment           : ${params.ENVIRONMENT}
Build                 : ${env.BUILD_NUMBER}
Delete TF Backend     : ${params.DELETE_TERRAFORM_BACKEND}

==============================================================
"""
                }

                sh '''
                    set -e

                    : > "$WORKSPACE/$DELETION_REPORT"

                    {
                        echo "=============================================================="
                        echo "             DELETION REPORT - BUILD ${BUILD_NUMBER}"
                        echo "=============================================================="
                        echo "Environment : ${ENVIRONMENT}"
                        echo "Timestamp   : $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
                        echo "=============================================================="
                        echo ""
                    } >> "$WORKSPACE/$DELETION_REPORT"

                    echo "Deletion report initialized: $WORKSPACE/$DELETION_REPORT"
                '''
            }
        }

        // ========================================================
        // 01. CLEAN WORKSPACE
        // ========================================================

        stage('01 - Clean Workspace') {

            steps {

                deleteDir()

                sh '''
                    set -e

                    echo "=============================================================="
                    echo "                    CLEAN WORKSPACE"
                    echo "=============================================================="

                    echo "Workspace:"
                    pwd

                    echo ""
                    echo "Jenkins node:"
                    hostname

                    echo ""
                    echo "Jenkins user:"
                    whoami

                    echo ""
                    echo "Workspace cleaned successfully."
                '''

                sh '''
                    set -e

                    : > "$WORKSPACE/$DELETION_REPORT"

                    {
                        echo "=============================================================="
                        echo "             DELETION REPORT - BUILD ${BUILD_NUMBER}"
                        echo "=============================================================="
                        echo "Environment : ${ENVIRONMENT}"
                        echo "Timestamp   : $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
                        echo "=============================================================="
                        echo ""
                    } >> "$WORKSPACE/$DELETION_REPORT"
                '''
            }
        }

        // ========================================================
        // 02. VERIFY TOOLS
        // ========================================================

        stage('02 - Verify Required Tools') {

            steps {

                sh '''
                    set -e

                    echo "=============================================================="
                    echo "                    VERIFY TOOLS"
                    echo "=============================================================="

                    echo ""
                    echo "Git:"
                    git --version

                    echo ""
                    echo "Terraform:"
                    terraform version

                    echo ""
                    echo "AWS CLI:"
                    aws --version

                    echo ""
                    echo "kubectl:"
                    kubectl version --client

                    echo ""
                    echo "jq:"
                    jq --version

                    echo ""
                    echo "Required tools are available."
                '''
            }
        }

        // ========================================================
        // 03. VERIFY AWS CREDENTIALS
        // ========================================================

        stage('03 - Verify AWS Credentials') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================================="
                        echo "                    AWS CREDENTIAL CHECK"
                        echo "=============================================================="

                        aws sts get-caller-identity

                        echo ""
                        echo "AWS Region:"
                        echo "$AWS_REGION"

                        echo ""
                        echo "AWS credentials are working."
                    '''
                }
            }
        }

        // ========================================================
        // 04. CHECKOUT TERRAFORM REPO
        // ========================================================

        stage('04 - Checkout Terraform Repository') {

            steps {

                dir("${TERRAFORM_DIR}") {

                    checkout([
                        $class: 'GitSCM',

                        branches: [
                            [
                                name: '*/main'
                            ]
                        ],

                        userRemoteConfigs: [
                            [
                                credentialsId:
                                    env.GITHUB_CREDENTIALS_ID,

                                url:
                                    env.TERRAFORM_REPO
                            ]
                        ]
                    ])
                }

                sh '''
                    set -e

                    echo "=============================================================="
                    echo "                 TERRAFORM REPOSITORY"
                    echo "=============================================================="

                    cd "$TERRAFORM_DIR"

                    echo "Repository:"
                    git remote get-url origin

                    echo ""
                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo ""
                    echo "Terraform repository checked out successfully."
                '''
            }
        }

        // ========================================================
        // 05. CHECKOUT CI/CD REPO
        // ========================================================

        stage('05 - Checkout CI/CD Repository') {

            steps {

                dir("${CICD_DIR}") {

                    checkout([
                        $class: 'GitSCM',

                        branches: [
                            [
                                name: '*/main'
                            ]
                        ],

                        userRemoteConfigs: [
                            [
                                credentialsId:
                                    env.GITHUB_CREDENTIALS_ID,

                                url:
                                    env.CICD_REPO
                            ]
                        ]
                    ])
                }

                sh '''
                    set -e

                    echo "=============================================================="
                    echo "                 CI/CD REPOSITORY"
                    echo "=============================================================="

                    cd "$CICD_DIR"

                    echo "Repository:"
                    git remote get-url origin

                    echo ""
                    echo "Commit:"
                    git rev-parse --short HEAD

                    echo ""
                    echo "CI/CD repository checked out successfully."
                '''
            }
        }

        // ========================================================
        // 06. CONFIGURE TERRAFORM BACKEND
        // ========================================================

        stage('06 - Configure Terraform Backend') {

            steps {

                sh '''
                    set -e

                    echo "=============================================================="
                    echo "             CONFIGURE TERRAFORM STATE BACKEND"
                    echo "=============================================================="

                    TERRAFORM_ENV_DIR="$WORKSPACE/$TERRAFORM_DIR/environments/$ENVIRONMENT"

                    if [ ! -d "$TERRAFORM_ENV_DIR" ]; then
                        echo "ERROR: Terraform environment directory not found:"
                        echo "$TERRAFORM_ENV_DIR"
                        exit 1
                    fi

                    echo "Terraform environment:"
                    echo "$TERRAFORM_ENV_DIR"

                    cat > "$TERRAFORM_ENV_DIR/backend.tf" <<EOF
terraform {
  backend "s3" {
    bucket         = "$TERRAFORM_STATE_BUCKET"
    key            = "practice1/$ENVIRONMENT/terraform.tfstate"
    region         = "$AWS_REGION"
    dynamodb_table = "$TERRAFORM_LOCK_TABLE"
    encrypt        = true
  }
}
EOF

                    echo ""
                    echo "Generated Terraform backend configuration:"
                    cat "$TERRAFORM_ENV_DIR/backend.tf"

                    echo ""
                    echo "Terraform backend configuration completed."
                '''
            }
        }

        // ========================================================
        // 06b. PRE-FLIGHT: CHECK TERRAFORM BACKEND EXISTS
        // ========================================================

        stage('06b - Pre-flight Backend Check') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set -e

                        echo "=============================================================="
                        echo "              PRE-FLIGHT TERRAFORM BACKEND CHECK"
                        echo "=============================================================="

                        BACKEND_READY="false"

                        # -------- Check S3 bucket --------
                        echo ""
                        echo "Checking S3 bucket: $TERRAFORM_STATE_BUCKET"

                        if aws s3api head-bucket \
                            --bucket "$TERRAFORM_STATE_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then
                            echo "  S3 bucket EXISTS."

                            # -------- Check state file --------
                            STATE_KEY="practice1/$ENVIRONMENT/terraform.tfstate"

                            echo ""
                            echo "Checking state file: s3://$TERRAFORM_STATE_BUCKET/$STATE_KEY"

                            if aws s3api head-object \
                                --bucket "$TERRAFORM_STATE_BUCKET" \
                                --key "$STATE_KEY" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then
                                echo "  State file EXISTS. Terraform backend is ready."
                                BACKEND_READY="true"
                            else
                                echo "  State file does NOT exist. Nothing for Terraform to destroy."
                            fi

                        else
                            echo "  S3 bucket does NOT exist. Terraform backend is not ready."
                        fi

                        # Write a flag file the Terraform stages can check
                        echo "$BACKEND_READY" > "$WORKSPACE/.backend_ready"

                        if [ "$BACKEND_READY" = "true" ]; then
                            echo "[READY]    Terraform Backend (S3 + state file present)" >> "$WORKSPACE/$DELETION_REPORT"
                        else
                            echo "[SKIPPED]  Terraform Backend missing - Terraform stages will be skipped" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "Pre-flight backend check completed. BACKEND_READY=$BACKEND_READY"
                    '''
                }
            }
        }

        // ========================================================
        // 07. CONFIGURE EKS ACCESS
        // ========================================================

        stage('07 - Configure EKS Access') {

            steps {

                dir("${CICD_DIR}") {

                    withCredentials([
                        [
                            $class: 'AmazonWebServicesCredentialsBinding',
                            credentialsId: env.AWS_CREDENTIALS_ID
                        ]
                    ]) {

                        sh '''
                            set +e

                            echo "=============================================================="
                            echo "                  CONFIGURE EKS ACCESS"
                            echo "=============================================================="

                            CLUSTER_NAME="${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                            if ! aws eks describe-cluster \
                                --name "$CLUSTER_NAME" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then
                                echo "Cluster does not exist. Skipping EKS access setup."
                                echo "[SKIPPED]  EKS Access Setup (cluster $CLUSTER_NAME not found)" >> "$WORKSPACE/$DELETION_REPORT"
                                exit 0
                            fi

                            if [ -x "./scripts/eks-configure.sh" ]; then
                                ./scripts/eks-configure.sh "$ENVIRONMENT" || {
                                    echo "EKS configure script failed. Continuing..."
                                }
                            else
                                echo "eks-configure.sh not found or not executable. Using aws eks update-kubeconfig."
                                aws eks update-kubeconfig \
                                    --name "$CLUSTER_NAME" \
                                    --region "$AWS_REGION" || true
                            fi

                            echo ""
                            echo "EKS access configuration attempted."
                        '''
                    }
                }
            }
        }

        // ========================================================
        // 08. DELETE KUBERNETES WORKLOADS
        // ========================================================

        stage('08 - Delete Kubernetes Workloads') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "               DELETE KUBERNETES WORKLOADS"
                        echo "=============================================================="

                        CLUSTER_NAME="${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        if ! aws eks describe-cluster \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then
                            echo "Cluster does not exist. Nothing to clean up."
                            echo "[SKIPPED]  Kubernetes Workloads (cluster $CLUSTER_NAME not found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        aws eks update-kubeconfig \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" || true

                        if ! kubectl get namespace "$K8S_NAMESPACE" >/dev/null 2>&1; then
                            echo "Namespace $K8S_NAMESPACE does not exist. Nothing to delete."
                            echo "[SKIPPED]  Kubernetes Namespace $K8S_NAMESPACE (not found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        echo ""
                        echo "Removing finalizers from namespace resources..."

                        kubectl get all -n "$K8S_NAMESPACE" -o name 2>/dev/null | while read -r RES; do
                            kubectl patch "$RES" -n "$K8S_NAMESPACE" \
                                -p '{"metadata":{"finalizers":[]}}' \
                                --type=merge 2>/dev/null || true
                        done

                        echo ""
                        echo "Deleting namespace: $K8S_NAMESPACE"

                        kubectl delete namespace "$K8S_NAMESPACE" \
                            --ignore-not-found=true \
                            --wait=false || true

                        echo ""
                        echo "Waiting for namespace to be removed..."

                        for i in $(seq 1 30); do
                            if ! kubectl get namespace "$K8S_NAMESPACE" >/dev/null 2>&1; then
                                echo "Namespace removed."
                                break
                            fi
                            echo "Attempt $i/30 - Namespace still terminating..."
                            sleep 10
                        done

                        if kubectl get namespace "$K8S_NAMESPACE" >/dev/null 2>&1; then
                            echo "Namespace stuck. Forcing finalization..."

                            kubectl get namespace "$K8S_NAMESPACE" -o json \
                                | jq '.spec.finalizers = []' \
                                | kubectl replace --raw \
                                    "/api/v1/namespaces/$K8S_NAMESPACE/finalize" \
                                    -f - 2>/dev/null || true
                        fi

                        if kubectl get namespace "$K8S_NAMESPACE" >/dev/null 2>&1; then
                            echo "[FAILED]   Kubernetes Namespace $K8S_NAMESPACE (still terminating)" >> "$WORKSPACE/$DELETION_REPORT"
                        else
                            echo "[DELETED]  Kubernetes Namespace $K8S_NAMESPACE" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "Kubernetes workloads cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 09. REMOVE CLOUDWATCH OBSERVABILITY ADD-ON
        // ========================================================

        stage('09 - Remove CloudWatch Observability Add-on') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "         REMOVE CLOUDWATCH OBSERVABILITY ADD-ON"
                        echo "=============================================================="

                        CLUSTER_NAME="${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        if ! aws eks describe-cluster \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then
                            echo "Cluster does not exist. Skipping add-on removal."
                            echo "[SKIPPED]  CloudWatch Addon (cluster $CLUSTER_NAME not found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        echo "Checking add-on: amazon-cloudwatch-observability"

                        if aws eks describe-addon \
                            --cluster-name "$CLUSTER_NAME" \
                            --addon-name amazon-cloudwatch-observability \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "Deleting add-on..."

                            aws eks delete-addon \
                                --cluster-name "$CLUSTER_NAME" \
                                --addon-name amazon-cloudwatch-observability \
                                --region "$AWS_REGION" \
                                --no-cli-pager || true

                            echo "Waiting for add-on to be deleted..."

                            aws eks wait addon-deleted \
                                --cluster-name "$CLUSTER_NAME" \
                                --addon-name amazon-cloudwatch-observability \
                                --region "$AWS_REGION" || true

                            if aws eks describe-addon \
                                --cluster-name "$CLUSTER_NAME" \
                                --addon-name amazon-cloudwatch-observability \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then
                                echo "[FAILED]   CloudWatch Observability Addon (still present)" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[DELETED]  CloudWatch Observability Addon" >> "$WORKSPACE/$DELETION_REPORT"
                            fi

                        else
                            echo "Add-on not found. Nothing to remove."
                            echo "[SKIPPED]  CloudWatch Observability Addon (not found)" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "CloudWatch Observability add-on removal completed."
                    '''
                }
            }
        }

        // ========================================================
        // 10. DELETE ECR REPOSITORIES
        // ========================================================

        stage('10 - Delete ECR Repositories') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                    DELETE ECR REPOSITORIES"
                        echo "=============================================================="

                        REPO_NAMES="
                            ${EKS_PROJECT_NAME}-${ENVIRONMENT}
                            ${EKS_PROJECT_NAME}
                            ${CONTAINER_NAME}-${ENVIRONMENT}
                            ${CONTAINER_NAME}
                            ${EKS_PROJECT_NAME}-${ENVIRONMENT}-app
                            ${EKS_PROJECT_NAME}-app
                        "

                        for REPO in $REPO_NAMES; do

                            REPO=$(echo "$REPO" | tr -d ' \\t\\r\\n')

                            [ -z "$REPO" ] && continue

                            echo ""
                            echo "Checking ECR repository: $REPO"

                            if aws ecr describe-repositories \
                                --repository-names "$REPO" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then

                                echo "Deleting ECR repository: $REPO (force)"

                                if aws ecr delete-repository \
                                    --repository-name "$REPO" \
                                    --region "$AWS_REGION" \
                                    --force \
                                    --no-cli-pager
                                then
                                    echo "[DELETED]  ECR Repository: $REPO" >> "$WORKSPACE/$DELETION_REPORT"
                                else
                                    echo "[FAILED]   ECR Repository: $REPO" >> "$WORKSPACE/$DELETION_REPORT"
                                fi

                            else
                                echo "Repository not found: $REPO"
                                echo "[SKIPPED]  ECR Repository: $REPO (not found)" >> "$WORKSPACE/$DELETION_REPORT"
                            fi
                        done

                        echo ""
                        echo "ECR cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 11. DELETE ORPHANED LOAD BALANCERS
        // ========================================================

        stage('11 - Delete Orphaned Load Balancers') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "              DELETE ORPHANED LOAD BALANCERS"
                        echo "=============================================================="

                        CLUSTER_TAG_KEY="kubernetes.io/cluster/${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        ANY_FOUND=0

                        CLASSIC=$(aws elb describe-load-balancers \
                            --region "$AWS_REGION" \
                            --query "LoadBalancerDescriptions[].LoadBalancerName" \
                            --output text 2>/dev/null || true)

                        for LB in $CLASSIC; do
                            TAGS=$(aws elb describe-tags \
                                --load-balancer-names "$LB" \
                                --region "$AWS_REGION" \
                                --query "TagDescriptions[0].Tags[?Key=='$CLUSTER_TAG_KEY'].Value" \
                                --output text 2>/dev/null || true)

                            if [ -n "$TAGS" ]; then
                                ANY_FOUND=1
                                echo "Deleting Classic ELB: $LB"
                                if aws elb delete-load-balancer \
                                    --load-balancer-name "$LB" \
                                    --region "$AWS_REGION"
                                then
                                    echo "[DELETED]  Classic ELB: $LB" >> "$WORKSPACE/$DELETION_REPORT"
                                else
                                    echo "[FAILED]   Classic ELB: $LB" >> "$WORKSPACE/$DELETION_REPORT"
                                fi
                            fi
                        done

                        V2=$(aws elbv2 describe-load-balancers \
                            --region "$AWS_REGION" \
                            --query "LoadBalancers[].LoadBalancerArn" \
                            --output text 2>/dev/null || true)

                        for LB_ARN in $V2; do
                            TAGS=$(aws elbv2 describe-tags \
                                --resource-arns "$LB_ARN" \
                                --region "$AWS_REGION" \
                                --query "TagDescriptions[0].Tags[?Key=='$CLUSTER_TAG_KEY'].Value" \
                                --output text 2>/dev/null || true)

                            if [ -n "$TAGS" ]; then
                                ANY_FOUND=1
                                echo "Deleting ALB/NLB: $LB_ARN"
                                if aws elbv2 delete-load-balancer \
                                    --load-balancer-arn "$LB_ARN" \
                                    --region "$AWS_REGION"
                                then
                                    echo "[DELETED]  ALB/NLB: $LB_ARN" >> "$WORKSPACE/$DELETION_REPORT"
                                else
                                    echo "[FAILED]   ALB/NLB: $LB_ARN" >> "$WORKSPACE/$DELETION_REPORT"
                                fi
                            fi
                        done

                        if [ "$ANY_FOUND" -eq 0 ]; then
                            echo "No orphaned load balancers found."
                            echo "[SKIPPED]  Load Balancers (none found)" >> "$WORKSPACE/$DELETION_REPORT"
                        else
                            echo "Waiting 30s for LB ENIs to be released..."
                            sleep 30
                        fi

                        echo ""
                        echo "Load balancer cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 12. TERRAFORM INIT (SKIPS GRACEFULLY IF BACKEND MISSING)
        // ========================================================

        stage('12 - Terraform Init') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                    TERRAFORM INIT"
                        echo "=============================================================="

                        BACKEND_READY=$(cat "$WORKSPACE/.backend_ready" 2>/dev/null || echo "false")

                        if [ "$BACKEND_READY" != "true" ]; then
                            echo "Terraform backend is not ready (S3 bucket or state file missing)."
                            echo "Skipping Terraform Init."
                            echo "[SKIPPED]  Terraform Init (backend not ready)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        TERRAFORM_ENV_DIR="$WORKSPACE/$TERRAFORM_DIR/environments/$ENVIRONMENT"

                        cd "$TERRAFORM_ENV_DIR"

                        if terraform init -reconfigure -input=false; then
                            echo "Terraform init completed."
                            echo "true" > "$WORKSPACE/.tf_init_ok"
                        else
                            echo "Terraform init failed. Marking Terraform stages to skip."
                            echo "[SKIPPED]  Terraform Init failed - destroy stages skipped" >> "$WORKSPACE/$DELETION_REPORT"
                            echo "false" > "$WORKSPACE/.tf_init_ok"
                        fi
                    '''
                }
            }
        }

        // ========================================================
        // 13. TERRAFORM DESTROY
        // ========================================================

        stage('13 - Terraform Destroy') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                   TERRAFORM DESTROY"
                        echo "=============================================================="

                        BACKEND_READY=$(cat "$WORKSPACE/.backend_ready" 2>/dev/null || echo "false")
                        TF_INIT_OK=$(cat "$WORKSPACE/.tf_init_ok"   2>/dev/null || echo "false")

                        if [ "$BACKEND_READY" != "true" ] || [ "$TF_INIT_OK" != "true" ]; then
                            echo "Skipping Terraform Destroy (backend not ready or init failed)."
                            echo "[SKIPPED]  Terraform Destroy (backend not ready / init failed)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        TERRAFORM_ENV_DIR="$WORKSPACE/$TERRAFORM_DIR/environments/$ENVIRONMENT"

                        cd "$TERRAFORM_ENV_DIR"

                        BEFORE=$(terraform state list 2>/dev/null | wc -l || echo 0)
                        echo "Resources in state before destroy: $BEFORE"

                        if [ "$BEFORE" -eq 0 ]; then
                            echo "Terraform state is already empty. Nothing to destroy."
                            echo "[SKIPPED]  Terraform Destroy (state already empty)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        echo "$BEFORE Terraform resources will be destroyed."

                        if terraform destroy \
                            -auto-approve \
                            -input=false \
                            -refresh=true
                        then
                            echo "[DELETED]  Terraform Infrastructure ($BEFORE resources)" >> "$WORKSPACE/$DELETION_REPORT"
                        else
                            echo "First destroy attempt failed. Retrying with refresh=false..."

                            if terraform destroy \
                                -auto-approve \
                                -input=false \
                                -refresh=false
                            then
                                echo "[DELETED]  Terraform Infrastructure ($BEFORE resources, retry)" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "Second destroy attempt failed. Final retry with parallelism=1..."

                                sleep 30

                                if terraform destroy \
                                    -auto-approve \
                                    -input=false \
                                    -refresh=false \
                                    -parallelism=1
                                then
                                    echo "[DELETED]  Terraform Infrastructure ($BEFORE resources, final retry)" >> "$WORKSPACE/$DELETION_REPORT"
                                else
                                    echo "[FAILED]   Terraform Destroy (state still has resources)" >> "$WORKSPACE/$DELETION_REPORT"
                                fi
                            fi
                        fi

                        AFTER=$(terraform state list 2>/dev/null | wc -l || echo 0)
                        echo ""
                        echo "Resources in state after destroy: $AFTER"

                        echo ""
                        echo "Terraform destroy completed."
                    '''
                }
            }
        }

        // ========================================================
        // 14. DELETE REMAINING ECR REPOSITORIES
        // ========================================================

        stage('14 - Delete Remaining ECR Repositories') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                DELETE REMAINING ECR REPOS"
                        echo "=============================================================="

                        REPOS=$(aws ecr describe-repositories \
                            --region "$AWS_REGION" \
                            --query "repositories[?contains(repositoryName, '${EKS_PROJECT_NAME}')].repositoryName" \
                            --output text 2>/dev/null || true)

                        if [ -z "$REPOS" ]; then
                            echo "No remaining ECR repositories found."
                            echo "[SKIPPED]  Remaining ECR Sweep (none found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        for REPO in $REPOS; do
                            echo "Deleting ECR repository: $REPO"
                            if aws ecr delete-repository \
                                --repository-name "$REPO" \
                                --region "$AWS_REGION" \
                                --force \
                                --no-cli-pager
                            then
                                echo "[DELETED]  ECR Repository (sweep): $REPO" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[FAILED]   ECR Repository (sweep): $REPO" >> "$WORKSPACE/$DELETION_REPORT"
                            fi
                        done

                        echo ""
                        echo "ECR sweep completed."
                    '''
                }
            }
        }

        // ========================================================
        // 15. DELETE CLOUDWATCH LOG GROUPS
        // ========================================================

        stage('15 - Delete CloudWatch Log Groups') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                DELETE CLOUDWATCH LOG GROUPS"
                        echo "=============================================================="

                        PREFIXES="
                            /aws/eks/${EKS_PROJECT_NAME}-${ENVIRONMENT}
                            /aws/containerinsights/${EKS_PROJECT_NAME}-${ENVIRONMENT}
                            /aws/eks/${EKS_PROJECT_NAME}
                            /aws/containerinsights/${EKS_PROJECT_NAME}
                            /aws/${EKS_PROJECT_NAME}-${ENVIRONMENT}
                            /aws/${EKS_PROJECT_NAME}
                            /aws/lambda/${EKS_PROJECT_NAME}
                        "

                        ANY_FOUND=0

                        for PREFIX in $PREFIXES; do

                            PREFIX=$(echo "$PREFIX" | tr -d ' \\t\\r\\n')

                            [ -z "$PREFIX" ] && continue

                            LOG_GROUPS=$(aws logs describe-log-groups \
                                --log-group-name-prefix "$PREFIX" \
                                --region "$AWS_REGION" \
                                --query 'logGroups[].logGroupName' \
                                --output text 2>/dev/null || true)

                            if [ -z "$LOG_GROUPS" ]; then
                                continue
                            fi

                            for LG in $LOG_GROUPS; do
                                ANY_FOUND=1
                                echo "Deleting log group: $LG"
                                if aws logs delete-log-group \
                                    --log-group-name "$LG" \
                                    --region "$AWS_REGION"
                                then
                                    echo "[DELETED]  CloudWatch Log Group: $LG" >> "$WORKSPACE/$DELETION_REPORT"
                                else
                                    echo "[FAILED]   CloudWatch Log Group: $LG" >> "$WORKSPACE/$DELETION_REPORT"
                                fi
                            done
                        done

                        if [ "$ANY_FOUND" -eq 0 ]; then
                            echo "No CloudWatch log groups found."
                            echo "[SKIPPED]  CloudWatch Log Groups (none found)" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "CloudWatch log group cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 16. DELETE ORPHANED EBS VOLUMES
        // ========================================================

        stage('16 - Delete Orphaned EBS Volumes') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "              DELETE ORPHANED EBS VOLUMES"
                        echo "=============================================================="

                        CLUSTER_TAG_KEY="kubernetes.io/cluster/${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        VOLUMES=$(aws ec2 describe-volumes \
                            --region "$AWS_REGION" \
                            --filters \
                                "Name=status,Values=available" \
                                "Name=tag-key,Values=$CLUSTER_TAG_KEY" \
                            --query "Volumes[].VolumeId" \
                            --output text 2>/dev/null || true)

                        if [ -z "$VOLUMES" ]; then
                            echo "No orphaned EBS volumes found."
                            echo "[SKIPPED]  Orphaned EBS Volumes (none found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        for VOL in $VOLUMES; do
                            echo "Deleting EBS volume: $VOL"
                            if aws ec2 delete-volume \
                                --volume-id "$VOL" \
                                --region "$AWS_REGION"
                            then
                                echo "[DELETED]  EBS Volume: $VOL" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[FAILED]   EBS Volume: $VOL" >> "$WORKSPACE/$DELETION_REPORT"
                            fi
                        done

                        echo ""
                        echo "EBS volume cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 17. REMOVE EKS ACCESS ENTRIES
        // ========================================================

        stage('17 - Remove EKS Access Entries') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "              REMOVE EKS ACCESS ENTRIES"
                        echo "=============================================================="

                        CLUSTER_NAME="${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        if ! aws eks describe-cluster \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then
                            echo "Cluster does not exist. Nothing to remove."
                            echo "[SKIPPED]  EKS Access Entries (cluster not found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        ENTRIES=$(aws eks list-access-entries \
                            --cluster-name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            --query 'accessEntries[]' \
                            --output text 2>/dev/null || true)

                        if [ -z "$ENTRIES" ]; then
                            echo "No access entries found."
                            echo "[SKIPPED]  EKS Access Entries (none found)" >> "$WORKSPACE/$DELETION_REPORT"
                            exit 0
                        fi

                        for ARN in $ENTRIES; do

                            [ -z "$ARN" ] && continue

                            echo ""
                            echo "Processing access entry: $ARN"

                            POLICIES=$(aws eks list-associated-access-policies \
                                --cluster-name "$CLUSTER_NAME" \
                                --principal-arn "$ARN" \
                                --region "$AWS_REGION" \
                                --query 'associatedAccessPolicies[].policyArn' \
                                --output text 2>/dev/null || true)

                            for P in $POLICIES; do
                                echo "  Disassociating policy: $P"
                                aws eks disassociate-access-policy \
                                    --cluster-name "$CLUSTER_NAME" \
                                    --principal-arn "$ARN" \
                                    --policy-arn "$P" \
                                    --region "$AWS_REGION" || true
                            done

                            if echo "$ARN" | grep -q "user/terraformlearn"; then
                                echo "  Skipping deletion of Jenkins user access entry (cluster creator)."
                                echo "[SKIPPED]  EKS Access Entry: $ARN (cluster creator)" >> "$WORKSPACE/$DELETION_REPORT"
                                continue
                            fi

                            echo "  Deleting access entry: $ARN"
                            if aws eks delete-access-entry \
                                --cluster-name "$CLUSTER_NAME" \
                                --principal-arn "$ARN" \
                                --region "$AWS_REGION"
                            then
                                echo "[DELETED]  EKS Access Entry: $ARN" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[FAILED]   EKS Access Entry: $ARN" >> "$WORKSPACE/$DELETION_REPORT"
                            fi
                        done

                        echo ""
                        echo "EKS access entry cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 18. VERIFY DESTRUCTION
        // ========================================================

        stage('18 - Verify Destruction') {

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "                  VERIFY DESTRUCTION"
                        echo "=============================================================="

                        CLUSTER_NAME="${EKS_PROJECT_NAME}-${ENVIRONMENT}"

                        echo ""
                        echo "1. EKS cluster check:"

                        if aws eks describe-cluster \
                            --name "$CLUSTER_NAME" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then
                            echo "   WARNING: Cluster still exists: $CLUSTER_NAME"
                            echo "[FAILED]   EKS Cluster still exists: $CLUSTER_NAME" >> "$WORKSPACE/$DELETION_REPORT"
                        else
                            echo "   OK: Cluster deleted: $CLUSTER_NAME"
                        fi

                        echo ""
                        echo "2. ECR repositories containing '${EKS_PROJECT_NAME}':"

                        ECR_REMAIN=$(aws ecr describe-repositories \
                            --region "$AWS_REGION" \
                            --query "repositories[?contains(repositoryName, '${EKS_PROJECT_NAME}')].repositoryName" \
                            --output text 2>/dev/null || true)

                        if [ -z "$ECR_REMAIN" ]; then
                            echo "   OK: No ECR repositories remain."
                        else
                            echo "   WARNING: ECR repositories remain:"
                            echo "$ECR_REMAIN"
                            echo "[FAILED]   Remaining ECR Repos: $ECR_REMAIN" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "3. CloudWatch log groups containing '${EKS_PROJECT_NAME}':"

                        LOG_REMAIN=$(aws logs describe-log-groups \
                            --region "$AWS_REGION" \
                            --query "logGroups[?contains(logGroupName, '${EKS_PROJECT_NAME}')].logGroupName" \
                            --output text 2>/dev/null || true)

                        if [ -z "$LOG_REMAIN" ]; then
                            echo "   OK: No CloudWatch log groups remain."
                        else
                            echo "   WARNING: Log groups remain:"
                            echo "$LOG_REMAIN"
                            echo "[FAILED]   Remaining Log Groups: $LOG_REMAIN" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "Destruction verification completed."
                    '''
                }
            }
        }

        // ========================================================
        // 19. OPTIONAL: DELETE TERRAFORM BACKEND
        // ========================================================

        stage('19 - Delete Terraform Backend (Optional)') {

            when {
                expression {
                    return params.DELETE_TERRAFORM_BACKEND == true
                }
            }

            steps {

                withCredentials([
                    [
                        $class: 'AmazonWebServicesCredentialsBinding',
                        credentialsId: env.AWS_CREDENTIALS_ID
                    ]
                ]) {

                    sh '''
                        set +e

                        echo "=============================================================="
                        echo "              DELETE TERRAFORM BACKEND"
                        echo "=============================================================="

                        echo "WARNING: Deleting S3 bucket and DynamoDB lock table."

                        # ---------------- S3 ----------------
                        if aws s3api head-bucket \
                            --bucket "$TERRAFORM_STATE_BUCKET" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            echo "Emptying S3 bucket: $TERRAFORM_STATE_BUCKET"

                            aws s3 rm "s3://$TERRAFORM_STATE_BUCKET" \
                                --recursive \
                                --region "$AWS_REGION" || true

                            VERSIONS=$(aws s3api list-object-versions \
                                --bucket "$TERRAFORM_STATE_BUCKET" \
                                --region "$AWS_REGION" \
                                --output json \
                                --query '{Objects: Versions[].{Key:Key,VersionId:VersionId}}' \
                                2>/dev/null || echo '{"Objects":null}')

                            if [ "$VERSIONS" != '{"Objects":null}' ] && [ -n "$VERSIONS" ]; then
                                aws s3api delete-objects \
                                    --bucket "$TERRAFORM_STATE_BUCKET" \
                                    --region "$AWS_REGION" \
                                    --delete "$VERSIONS" || true
                            fi

                            MARKERS=$(aws s3api list-object-versions \
                                --bucket "$TERRAFORM_STATE_BUCKET" \
                                --region "$AWS_REGION" \
                                --output json \
                                --query '{Objects: DeleteMarkers[].{Key:Key,VersionId:VersionId}}' \
                                2>/dev/null || echo '{"Objects":null}')

                            if [ "$MARKERS" != '{"Objects":null}' ] && [ -n "$MARKERS" ]; then
                                aws s3api delete-objects \
                                    --bucket "$TERRAFORM_STATE_BUCKET" \
                                    --region "$AWS_REGION" \
                                    --delete "$MARKERS" || true
                            fi

                            echo "Deleting bucket: $TERRAFORM_STATE_BUCKET"

                            if aws s3api delete-bucket \
                                --bucket "$TERRAFORM_STATE_BUCKET" \
                                --region "$AWS_REGION"
                            then
                                echo "[DELETED]  S3 State Bucket: $TERRAFORM_STATE_BUCKET" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[FAILED]   S3 State Bucket: $TERRAFORM_STATE_BUCKET" >> "$WORKSPACE/$DELETION_REPORT"
                            fi

                        else
                            echo "S3 bucket does not exist: $TERRAFORM_STATE_BUCKET"
                            echo "[SKIPPED]  S3 State Bucket: $TERRAFORM_STATE_BUCKET (not found)" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        # ---------------- DynamoDB ----------------
                        if aws dynamodb describe-table \
                            --table-name "$TERRAFORM_LOCK_TABLE" \
                            --region "$AWS_REGION" \
                            >/dev/null 2>&1
                        then

                            aws dynamodb delete-table \
                                --table-name "$TERRAFORM_LOCK_TABLE" \
                                --region "$AWS_REGION" || true

                            aws dynamodb wait table-not-exists \
                                --table-name "$TERRAFORM_LOCK_TABLE" \
                                --region "$AWS_REGION" || true

                            if aws dynamodb describe-table \
                                --table-name "$TERRAFORM_LOCK_TABLE" \
                                --region "$AWS_REGION" \
                                >/dev/null 2>&1
                            then
                                echo "[FAILED]   DynamoDB Lock Table: $TERRAFORM_LOCK_TABLE" >> "$WORKSPACE/$DELETION_REPORT"
                            else
                                echo "[DELETED]  DynamoDB Lock Table: $TERRAFORM_LOCK_TABLE" >> "$WORKSPACE/$DELETION_REPORT"
                            fi

                        else
                            echo "DynamoDB lock table does not exist: $TERRAFORM_LOCK_TABLE"
                            echo "[SKIPPED]  DynamoDB Lock Table: $TERRAFORM_LOCK_TABLE (not found)" >> "$WORKSPACE/$DELETION_REPORT"
                        fi

                        echo ""
                        echo "Terraform backend cleanup completed."
                    '''
                }
            }
        }

        // ========================================================
        // 20. FINAL DELETION REPORT
        // ========================================================

        stage('20 - Deletion Report') {

            steps {

                sh '''
                    set +e

                    echo ""
                    echo "##############################################################"
                    echo "#                                                            #"
                    echo "#                 FINAL DELETION REPORT                      #"
                    echo "#                                                            #"
                    echo "##############################################################"
                    echo ""

                    cat "$WORKSPACE/$DELETION_REPORT"

                    echo ""
                    echo "=============================================================="
                    echo "                   DELETION SUMMARY"
                    echo "=============================================================="

                    DELETED_COUNT=$(grep -c "^\\[DELETED\\]" "$WORKSPACE/$DELETION_REPORT" || true)
                    SKIPPED_COUNT=$(grep -c "^\\[SKIPPED\\]" "$WORKSPACE/$DELETION_REPORT" || true)
                    FAILED_COUNT=$(grep -c "^\\[FAILED\\]"  "$WORKSPACE/$DELETION_REPORT" || true)

                    echo ""
                    echo "  Resources DELETED : $DELETED_COUNT"
                    echo "  Resources SKIPPED : $SKIPPED_COUNT  (already absent)"
                    echo "  Resources FAILED  : $FAILED_COUNT"

                    echo ""
                    if [ "$DELETED_COUNT" -gt 0 ]; then
                        echo "--------------------------------------------------------------"
                        echo "  DELETED IN THIS RUN:"
                        echo "--------------------------------------------------------------"
                        grep "^\\[DELETED\\]" "$WORKSPACE/$DELETION_REPORT" | sed 's/^/    /'
                    else
                        echo "  No resources were deleted in this run."
                    fi

                    echo ""
                    if [ "$SKIPPED_COUNT" -gt 0 ]; then
                        echo "--------------------------------------------------------------"
                        echo "  ALREADY ABSENT (skipped):"
                        echo "--------------------------------------------------------------"
                        grep "^\\[SKIPPED\\]" "$WORKSPACE/$DELETION_REPORT" | sed 's/^/    /'
                    fi

                    echo ""
                    if [ "$FAILED_COUNT" -gt 0 ]; then
                        echo "--------------------------------------------------------------"
                        echo "  FAILED TO DELETE (needs manual attention):"
                        echo "--------------------------------------------------------------"
                        grep "^\\[FAILED\\]" "$WORKSPACE/$DELETION_REPORT" | sed 's/^/    /'
                    fi

                    echo ""
                    echo "=============================================================="
                    echo "               END OF DELETION REPORT"
                    echo "=============================================================="
                '''
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        always {

            script {

                def reportText = ''

                try {

                    reportText = sh(
                        script: 'cat "$WORKSPACE/$DELETION_REPORT" 2>/dev/null || echo "(no report)"',
                        returnStdout: true
                    ).trim()

                } catch (Exception e) {

                    reportText = '(report not available)'
                }

                def resultBanner = (currentBuild.result == 'SUCCESS') ?
                    'DESTROY PIPELINE COMPLETED' :
                    'DESTROY PIPELINE FINISHED WITH ISSUES'

                echo """
==============================================================
             ${resultBanner}
==============================================================

Environment           : ${params.ENVIRONMENT}
Build                 : ${env.BUILD_NUMBER}
Cluster               : ${env.EKS_PROJECT_NAME}-${params.ENVIRONMENT}
Namespace             : ${env.K8S_NAMESPACE}
Terraform Backend Del : ${params.DELETE_TERRAFORM_BACKEND}

==============================================================
                    DELETION REPORT
==============================================================
${reportText}
==============================================================
"""
            }

            archiveArtifacts(
                artifacts: "${env.DELETION_REPORT}",
                allowEmptyArchive: true,
                fingerprint: true
            )

            sh '''
                echo "=============================================================="
                echo "                    WORKSPACE CLEANUP"
                echo "=============================================================="

                rm -rf \
                    "$APPLICATION_DIR/__pycache__" \
                    "$APPLICATION_DIR/.pytest_cache" \
                    2>/dev/null || true

                echo "Temporary application files cleaned."
            '''
        }
    }
}
