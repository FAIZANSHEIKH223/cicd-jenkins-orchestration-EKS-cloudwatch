pipeline {

    agent any

    // ============================================================
    // PIPELINE OPTIONS
    // ============================================================

    options {

        timestamps()

        ansiColor('xterm')

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                daysToKeepStr: '30',
                numToKeepStr: '50'
            )
        )

        timeout(
            time: 30,
            unit: 'MINUTES'
        )
    }

    // ============================================================
    // ENVIRONMENT
    // ============================================================

    environment {

        AWS_DEFAULT_REGION = 'us-east-1'

        TERRAFORM_STATE_BUCKET = 'terraform-state-faizan-001'

        TERRAFORM_LOCK_TABLE = 'terraform-locks'
    }

    // ============================================================
    // STAGES
    // ============================================================

    stages {

        // ========================================================
        // 01 - CHECK AWS CLI AND CREDENTIALS
        // ========================================================

        stage('01 - Check AWS CLI and Credentials') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "        TERRAFORM BACKEND FORCE DESTROY"
                        echo "============================================================"

                        echo ""
                        echo "AWS CLI:"
                        aws --version

                        echo ""
                        echo "AWS Region:"
                        echo "${AWS_DEFAULT_REGION}"

                        echo ""
                        echo "AWS Identity:"
                        aws sts get-caller-identity

                        echo ""
                        echo "AWS credentials are working."
                    '''
                }
            }
        }

        // ========================================================
        // 02 - CHECK S3 BUCKET
        // ========================================================

        stage('02 - Check S3 Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "                    CHECK S3 BUCKET"
                        echo "============================================================"

                        echo ""
                        echo "Bucket: ${TERRAFORM_STATE_BUCKET}"

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 bucket EXISTS."
                        else
                            echo ""
                            echo "S3 bucket does NOT exist."
                            echo "Nothing to delete."
                        fi
                    '''
                }
            }
        }

        // ========================================================
        // 03 - DELETE ALL S3 OBJECT VERSIONS AND DELETE MARKERS
        //      (uses aws s3api delete-objects - batch of 1000)
        // ========================================================

        stage('03 - Delete All S3 Object Versions and Delete Markers') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "   DELETE ALL S3 OBJECT VERSIONS + DELETE MARKERS"
                        echo "============================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 bucket already deleted. Skipping."
                            exit 0
                        fi

                        ########################################################
                        # Helper: check python3 availability
                        ########################################################
                        PY=""
                        if command -v python3 >/dev/null 2>&1; then
                            PY="python3"
                        elif command -v python >/dev/null 2>&1; then
                            PY="python"
                        else
                            echo "ERROR: python3/python is required for JSON parsing."
                            exit 1
                        fi

                        echo ""
                        echo "Using Python interpreter: ${PY}"

                        ########################################################
                        # DELETE OBJECT VERSIONS
                        ########################################################
                        echo ""
                        echo "------------------------------------------------------------"
                        echo " Deleting all object VERSIONS"
                        echo "------------------------------------------------------------"

                        while : ; do

                            aws s3api list-object-versions \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --max-items 1000 \
                                --query 'Versions[*].[Key,VersionId]' \
                                --output json > /tmp/s3_versions.json

                            COUNT=$("${PY}" -c "import json,sys; d=json.load(open('/tmp/s3_versions.json')); print(len(d)) if d else print(0)" 2>/dev/null || echo 0)

                            echo "Found ${COUNT} version(s) to delete."

                            if [ "${COUNT}" = "0" ]; then
                                break
                            fi

                            "${PY}" - <<'PYEOF'
import json

with open('/tmp/s3_versions.json') as f:
    data = json.load(f)

objects = [{"Key": k, "VersionId": v} for k, v in data]

with open('/tmp/s3_delete_batch.json', 'w') as f:
    json.dump({"Objects": objects, "Quiet": True}, f)

print(f"Prepared batch of {len(objects)} object versions.")
PYEOF

                            aws s3api delete-objects \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --delete file:///tmp/s3_delete_batch.json \
                                >/dev/null

                            echo "Batch deleted. Checking for remaining versions..."
                        done

                        echo "All object versions deleted."

                        ########################################################
                        # DELETE MARKERS
                        ########################################################
                        echo ""
                        echo "------------------------------------------------------------"
                        echo " Deleting all DELETE MARKERS"
                        echo "------------------------------------------------------------"

                        while : ; do

                            aws s3api list-object-versions \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --max-items 1000 \
                                --query 'DeleteMarkers[*].[Key,VersionId]' \
                                --output json > /tmp/s3_markers.json

                            COUNT=$("${PY}" -c "import json,sys; d=json.load(open('/tmp/s3_markers.json')); print(len(d)) if d else print(0)" 2>/dev/null || echo 0)

                            echo "Found ${COUNT} delete marker(s) to delete."

                            if [ "${COUNT}" = "0" ]; then
                                break
                            fi

                            "${PY}" - <<'PYEOF'
import json

with open('/tmp/s3_markers.json') as f:
    data = json.load(f)

objects = [{"Key": k, "VersionId": v} for k, v in data]

with open('/tmp/s3_delete_batch.json', 'w') as f:
    json.dump({"Objects": objects, "Quiet": True}, f)

print(f"Prepared batch of {len(objects)} delete markers.")
PYEOF

                            aws s3api delete-objects \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                --delete file:///tmp/s3_delete_batch.json \
                                >/dev/null

                            echo "Batch deleted. Checking for remaining markers..."
                        done

                        echo "All delete markers deleted."
                    '''
                }
            }
        }

        // ========================================================
        // 04 - VERIFY S3 BUCKET IS EMPTY
        // ========================================================

        stage('04 - Verify S3 Bucket Is Empty') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "            VERIFY S3 BUCKET IS EMPTY"
                        echo "============================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 bucket already deleted. Nothing to verify."
                            exit 0
                        fi

                        REMAINING=$(aws s3api list-object-versions \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --output json)

                        VERSIONS=$(echo "${REMAINING}" | python3 -c "import json,sys; d=json.load(sys.stdin); print(len(d.get('Versions') or []))")
                        MARKERS=$(echo "${REMAINING}" | python3 -c "import json,sys; d=json.load(sys.stdin); print(len(d.get('DeleteMarkers') or []))")

                        echo ""
                        echo "Remaining object versions : ${VERSIONS}"
                        echo "Remaining delete markers  : ${MARKERS}"

                        if [ "${VERSIONS}" != "0" ] || [ "${MARKERS}" != "0" ]; then
                            echo ""
                            echo "ERROR: S3 bucket still contains objects."
                            exit 1
                        fi

                        echo ""
                        echo "S3 bucket is completely empty."
                    '''
                }
            }
        }

        // ========================================================
        // 05 - FORCE DELETE S3 BUCKET
        // ========================================================

        stage('05 - Force Delete S3 Bucket') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "                DELETE S3 BUCKET"
                        echo "============================================================"

                        if ! aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "S3 bucket is already deleted."
                            exit 0
                        fi

                        echo ""
                        echo "Deleting S3 bucket: ${TERRAFORM_STATE_BUCKET}"

                        aws s3api delete-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}"

                        echo "Delete request submitted."

                        echo ""
                        echo "Waiting for S3 bucket deletion..."

                        for i in $(seq 1 30); do
                            if aws s3api head-bucket \
                                --bucket "${TERRAFORM_STATE_BUCKET}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then
                                echo "Attempt ${i}/30 - bucket still exists. Waiting..."
                                sleep 2
                            else
                                echo ""
                                echo "S3 bucket has been deleted."
                                exit 0
                            fi
                        done

                        echo ""
                        echo "ERROR: S3 bucket still exists after waiting."
                        exit 1
                    '''
                }
            }
        }

        // ========================================================
        // 06 - CHECK DYNAMODB LOCK TABLE
        // ========================================================

        stage('06 - Check DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "             CHECK DYNAMODB LOCK TABLE"
                        echo "============================================================"

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "DynamoDB table EXISTS."
                        else
                            echo ""
                            echo "DynamoDB table does NOT exist."
                            echo "Nothing to delete."
                        fi
                    '''
                }
            }
        }

        // ========================================================
        // 07 - FORCE DELETE DYNAMODB LOCK TABLE
        // ========================================================

        stage('07 - Force Delete DynamoDB Lock Table') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo "============================================================"
                        echo "          DELETE DYNAMODB LOCK TABLE"
                        echo "============================================================"

                        if ! aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo ""
                            echo "DynamoDB table already deleted."
                            exit 0
                        fi

                        TABLE_STATUS=$(aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            --query 'Table.TableStatus' \
                            --output text)

                        echo ""
                        echo "Current status: ${TABLE_STATUS}"

                        echo ""
                        echo "Deleting DynamoDB table: ${TERRAFORM_LOCK_TABLE}"

                        aws dynamodb delete-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null

                        echo "Delete request submitted."

                        echo ""
                        echo "Waiting for DynamoDB deletion..."

                        for i in $(seq 1 30); do
                            if aws dynamodb describe-table \
                                --table-name "${TERRAFORM_LOCK_TABLE}" \
                                --region "${AWS_DEFAULT_REGION}" \
                                >/dev/null 2>&1
                            then
                                echo "Attempt ${i}/30 - table still exists. Waiting..."
                                sleep 2
                            else
                                echo ""
                                echo "DynamoDB table has been deleted."
                                exit 0
                            fi
                        done

                        echo ""
                        echo "ERROR: DynamoDB table still exists after waiting."
                        exit 1
                    '''
                }
            }
        }

        // ========================================================
        // 08 - FINAL DESTROY VERIFICATION
        // ========================================================

        stage('08 - Final Destroy Verification') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: 'aws-creds',
                     accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                     secretKeyVariable: 'AWS_SECRET_ACCESS_KEY']
                ]) {

                    sh '''#!/bin/bash
                        set -uo pipefail

                        echo ""
                        echo "============================================================"
                        echo "             FINAL DESTROY VERIFICATION"
                        echo "============================================================"

                        FAILED=0

                        echo ""
                        echo "Checking S3 bucket..."

                        if aws s3api head-bucket \
                            --bucket "${TERRAFORM_STATE_BUCKET}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "ERROR: S3 bucket STILL EXISTS."
                            FAILED=1
                        else
                            echo "S3 bucket: DELETED"
                        fi

                        echo ""
                        echo "Checking DynamoDB table..."

                        if aws dynamodb describe-table \
                            --table-name "${TERRAFORM_LOCK_TABLE}" \
                            --region "${AWS_DEFAULT_REGION}" \
                            >/dev/null 2>&1
                        then
                            echo "ERROR: DynamoDB table STILL EXISTS."
                            FAILED=1
                        else
                            echo "DynamoDB table: DELETED"
                        fi

                        if [ "${FAILED}" = "1" ]; then
                            echo ""
                            echo "============================================================"
                            echo "             DESTRUCTION INCOMPLETE"
                            echo "============================================================"
                            exit 1
                        fi

                        echo ""
                        echo "============================================================"
                        echo "              COMPLETE DESTRUCTION SUCCESS"
                        echo "============================================================"
                        echo ""
                        echo "S3 bucket: ${TERRAFORM_STATE_BUCKET} -> DELETED"
                        echo "DynamoDB : ${TERRAFORM_LOCK_TABLE} -> DELETED"
                        echo "Region   : ${AWS_DEFAULT_REGION}"
                        echo ""
                        echo "No Terraform backend resources remain."
                        echo "============================================================"
                    '''
                }
            }
        }
    }

    // ============================================================
    // POST ACTIONS
    // ============================================================

    post {

        success {
            echo 'Terraform backend resources were completely destroyed.'
        }

        failure {
            echo 'Terraform backend destroy FAILED. Check the failed stage above.'
        }

        always {
            sh '''#!/bin/bash
                rm -f /tmp/s3_versions.json \
                      /tmp/s3_markers.json \
                      /tmp/s3_delete_batch.json \
                      2>/dev/null || true
                echo 'Terraform backend destroy pipeline execution finished.'
            '''
        }
    }
}
